{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Debug C++ from Executable",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/parrot_debug",
            "args": ["-t", "bash", "ls"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C++: g++ build active file for debug"
        }
    ]
}